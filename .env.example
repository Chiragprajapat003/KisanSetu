# ==============================================================================
# 🌱 KisanSetu (AgriDirect) Environment Configuration Example
# Copy this file to .env and customize values as needed
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB)
# ------------------------------------------------------------------------------
# In Docker: Use 'mongodb://mongo:27017/agridirect' (internal Docker DNS)
# Locally / Atlas: Use 'mongodb://localhost:27017/agridirect' or your MongoDB Atlas URI
MONGO_URI=mongodb://mongo:27017/agridirect

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. FRONTEND & CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api
VITE_SOCKET_URL=http://localhost:5005
VITE_AI_URL=http://localhost:5008

# ------------------------------------------------------------------------------
# 4. MICROSERVICES PORTS
# ------------------------------------------------------------------------------
GATEWAY_PORT=8000
AUTH_PORT=5001
USER_PORT=5002
PRODUCT_PORT=5003
ORDER_PORT=5004
COMMUNICATION_PORT=5005
FEEDBACK_PORT=5006
PAYMENT_SERVICE_PORT=5007
AI_SERVICE_PORT=5008

# ------------------------------------------------------------------------------
# 5. SERVICE URLS (Inter-service Communication & Gateway Routing)
# In Docker: Use service container names (http://auth:5001, http://user:5002, etc.)
# Local Development: Use http://127.0.0.1:PORT
# ------------------------------------------------------------------------------
AUTH_SERVICE=http://auth:5001
USER_SERVICE=http://user:5002
PRODUCT_SERVICE=http://product:5003
ORDER_SERVICE=http://order:5004
COMM_SERVICE=http://communication:5005
FEEDBACK_SERVICE=http://feedback:5006
PAYMENT_SERVICE=http://payment:5007
AI_SERVICE=http://ai-service:5008
PRODUCT_SERVICE_URL=http://product:5003/api/products

# ------------------------------------------------------------------------------
# 6. AI SERVICE & VOICE ASSISTANT (Groq LLM)
# ------------------------------------------------------------------------------
# Get your free Groq API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
AI_REQUEST_TIMEOUT=10
AI_MAX_IMAGE_SIZE_MB=2

# ------------------------------------------------------------------------------
# 7. PAYMENT GATEWAY (Razorpay Test Keys)
# ------------------------------------------------------------------------------
# Test keys for development & sandbox payments
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 8. EMAIL & NOTIFICATIONS (SMTP)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
